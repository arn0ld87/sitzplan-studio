# Vorlage für `.env`. Kopieren, Werte des eigenen Supabase-Projekts eintragen:
#
#   cp .env.example .env
#
# Die Werte stehen im Supabase-Dashboard unter Project Settings → API.
# Es sind ausschließlich **publishable** Schlüssel — sie werden beim Bauen in
# das ausgelieferte JavaScript geschrieben und sind damit öffentlich. Ein
# Service-Role-Schlüssel gehört niemals in diese Datei; er würde jede
# RLS-Policy aushebeln.
#
# Die VITE_-Variablen liest der Browser, die gleichnamigen ohne Präfix der
# SSR-Teil. Beide zeigen auf dasselbe Projekt.
#
# Vite liest diese Datei nur beim Start: nach jeder Änderung den Dev-Server
# neu starten, sonst arbeitet die App weiter gegen das alte Projekt.

SUPABASE_PROJECT_ID="dein-projekt-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://dein-projekt-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="dein-projekt-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://dein-projekt-ref.supabase.co"
